# Clasp configuration (never commit — generated locally per user)
.clasp.json
.clasprc.json
**/.clasprc.json

# OpenCode agent session state (local only)
.opencode/

# One-shot installer (self-destructs after running — never commit)
Initial install.bat

# Node / tooling
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Secrets — keys live in Apps Script > Project Settings > Script Properties,
# never in files. Do not commit service-account JSON, .env files, or tokens.
.env
.env.*
*-credentials.json
*service-account*.json
secrets/

# Per-user Web App deployment ID
.cashlogger-deployment-id